# Copy to .env.local and fill in. See docs/configuration.md for what each one does.

# Database
DATABASE_URL=

# Site address without a trailing slash (sign-in callbacks and payment returns).
# Leave empty locally: sign-in uses the address you opened, payments use http://localhost:3000.
SITE_URL=

# npm run dev only: extra addresses allowed to open the dev server, comma-separated (e.g. 192.168.1.20)
ALLOWED_DEV_ORIGINS=

# Optional: only show books distributed to this tenant
STORY_TENANT=

# Sign-in (required on the live server)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
EMAIL_CODE=

# Email
RESEND_API_KEY=

# Google / Facebook sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# File uploads (S3)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_WEEKLY=
STRIPE_PRICE_MONTHLY=

# PayPal: PAYPAL_ENV=live for real payments, anything else uses the sandbox
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_PLAN_WEEKLY=
PAYPAL_PLAN_MONTHLY=
PAYPAL_WEBHOOK_ID=
